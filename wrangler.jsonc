{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wishline",
  "main": "./worker.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "FIREBASE_PROJECT_ID": "wishline-staging"
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wishline",
      "database_id": "3798553f-0699-4e53-9200-8b5419ff1e30",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
