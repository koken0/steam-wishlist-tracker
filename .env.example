# Use "fixture" for the committed anonymous sample or "steam" for live data.
WISHLIST_DATA_SOURCE=fixture

# Required only when WISHLIST_DATA_SOURCE=steam.
# Never commit the real key and never expose it through NEXT_PUBLIC_* variables.
STEAM_FINANCIAL_API_KEY=
STEAM_APP_ID=

# Optional display metadata. The wishlist API does not return the game name.
STEAM_PROJECT_NAME=

# Safe local defaults. Lookback is capped at 90 days by the connector.
STEAM_LOOKBACK_DAYS=30
STEAM_CACHE_SECONDS=1800

# Required for hosted live mode. Supply the stable authenticated user IDs that
# may read the project, separated by commas. Local development stays loopback-only.
WISHLIST_ALLOWED_USER_IDS=

# Required when the API key is entered through Wishline onboarding. Generate a
# unique 32-byte base64 value and configure it as a server-side deployment secret.
WISHLIST_ENCRYPTION_KEY=

# Non-secret identifier written into new encryption envelopes. During a
# controlled rotation, configure the previous key and ID temporarily so old
# and new envelopes remain readable until re-wrapping completes.
WISHLIST_ENCRYPTION_KEY_ID=primary
WISHLIST_PREVIOUS_ENCRYPTION_KEY=
WISHLIST_PREVIOUS_ENCRYPTION_KEY_ID=

# Separate bearer secret for the privileged re-wrapping endpoint.
WISHLINE_ROTATION_SECRET=

# Required by the private hourly synchronization endpoint. Configure the same
# secret in the scheduler's Authorization: Bearer header.
WISHLINE_SYNC_SECRET=

# Separate read-only bearer secret for aggregate scheduler health. This token
# cannot trigger synchronization and must not be reused as WISHLINE_SYNC_SECRET.
WISHLINE_MONITOR_SECRET=
WISHLINE_MONITOR_URL=https://wishline.celkoken.workers.dev/api/internal/scheduler-health

# Required for browser Web Push. Generate one P-256 VAPID pair and keep the
# private key server-side. The subject may be the deployed HTTPS origin while
# Wishline has no support email/domain.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://wishline.celkoken.workers.dev

# Enables Firebase ID-token validation in hosted environments. When omitted,
# local development continues to use its trusted simulated platform identity.
FIREBASE_PROJECT_ID=

# Immutable authenticated IDs allowed to open /admin, separated by commas.
# For Firebase use the full Wishline ID form: firebase:<Firebase UID>.
WISHLINE_ADMIN_USER_IDS=

# Temporary shared gate for the private beta. Configure only as a server-side
# secret; removing it disables the gate. Use a long, randomly generated value.
WISHLINE_BETA_PASSWORD=
