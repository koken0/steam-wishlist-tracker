{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/ensure-local-encryption-key.mjs",
    "dev": "vinext dev --host 127.0.0.1",
    "build": "vinext build",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "db:migrate:cloudflare": "wrangler d1 migrations apply wishline --remote",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "setup:local": "node scripts/ensure-local-encryption-key.mjs",
    "test:fixture": "node scripts/validate-fixture.mjs",
    "test:contract": "node --experimental-strip-types --test lib/*.test.ts",
    "test:onboarding": "node --env-file-if-exists=.env.local scripts/verify-local-onboarding.mjs",
    "steam:capture": "node --env-file-if-exists=.env.local scripts/capture-steam-wishlist.mjs"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "jose": "^6.2.11",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.1",
    "@cloudflare/workers-types": "5.20260827.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.127.0"
  },
  "type": "module"
}
